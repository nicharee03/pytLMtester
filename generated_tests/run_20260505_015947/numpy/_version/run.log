                    vercmp = -1
                else:
                    vercmp = 1

        return vercmp

    def __lt__(self, other: 'NumpyVersion' | str) -> bool:
        return self._compare(other) < 0

    def __le__(self, other: 'NumpyVersion' | str) -> bool:
        return self._compare(other) <= 0

    def __eq__(self, other: 'NumpyVersion' | str) -> bool:
        return self._compare(other) == 0

    def __ne__(self, other: 'NumpyVersion' | str) -> bool:
        return self._compare(other) != 0

    def __gt__(self, other: 'NumpyVersion' | str) -> bool:
        return self._compare(other) > 0

    def __ge__(self, other: 'NumpyVersion' | str) -> bool:
